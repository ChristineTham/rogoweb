{
  "name": "rogoweb",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "build:emcurses": "make -C rogue/emcurses/emscripten CC=emcc AR=emar RANLIB=emranlib libs",
    "build:rogue": "make -C rogue -f Makefile.wasm",
    "build:rogomatic": "make -C rogomatic/src -f Makefile.wasm",
    "build:wasm": "npm run build:emcurses && npm run build:rogue && npm run build:rogomatic",
    "clean:wasm": "make -C rogue/emcurses/emscripten clean && make -C rogue -f Makefile.wasm clean && make -C rogomatic/src -f Makefile.wasm clean"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^25.9.2",
    "@vitest/browser": "^4.1.8",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@xterm/addon-canvas": "^0.7.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "tailwindcss": "^4.3.0"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
